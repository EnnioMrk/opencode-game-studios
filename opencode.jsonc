{
  // OpenCode Game Studios — project configuration.
  //
  // Ported from the Claude Code Game Studios template. Rules are evaluated in
  // order and the LAST matching rule wins, so the broad "ask" rules come first
  // and the specific allow/deny rules after them.
  //
  // "ask" is resolved by the client (OpenChamber shows a prompt). "deny" is
  // final: no client prompt can override it.
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    // --- Ask-first baseline (mirrors the original template's default mode) ---
    { "action": "edit", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "ask" },

    // --- Shell commands that never prompt ---
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "dir *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git branch *", "effect": "allow" },
    { "action": "shell", "resource": "python -m pytest *", "effect": "allow" },
    { "action": "shell", "resource": "py -m pytest *", "effect": "allow" },
    { "action": "shell", "resource": "pytest *", "effect": "allow" },

    // --- Denied: recursive deletes ---
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
    { "action": "shell", "resource": "rm -fr *", "effect": "deny" },
    { "action": "shell", "resource": "rm -r -f *", "effect": "deny" },
    { "action": "shell", "resource": "rm -f -r *", "effect": "deny" },
    { "action": "shell", "resource": "rm -Rf *", "effect": "deny" },
    { "action": "shell", "resource": "rm -fR *", "effect": "deny" },
    { "action": "shell", "resource": "rm --recursive --force *", "effect": "deny" },
    { "action": "shell", "resource": "rm --force --recursive *", "effect": "deny" },

    // --- Denied: history-rewriting or destructive git ---
    { "action": "shell", "resource": "git push --force*", "effect": "deny" },
    { "action": "shell", "resource": "git push -f *", "effect": "deny" },
    { "action": "shell", "resource": "git push * --force*", "effect": "deny" },
    { "action": "shell", "resource": "git push * -f *", "effect": "deny" },
    { "action": "shell", "resource": "git push * +*", "effect": "deny" },
    { "action": "shell", "resource": "git * push * --force*", "effect": "deny" },
    { "action": "shell", "resource": "git *push* -uf *", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "deny" },
    { "action": "shell", "resource": "git * reset * --hard*", "effect": "deny" },
    { "action": "shell", "resource": "git clean* -f*", "effect": "deny" },
    { "action": "shell", "resource": "git clean* --force*", "effect": "deny" },
    { "action": "shell", "resource": "git *clean* -f*", "effect": "deny" },
    { "action": "shell", "resource": "git *clean* --force*", "effect": "deny" },

    // --- Denied: system-level or secret-exposing commands ---
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "chmod 777*", "effect": "deny" },
    { "action": "shell", "resource": "*>.env*", "effect": "deny" },
    { "action": "shell", "resource": "cat *.env*", "effect": "deny" },
    { "action": "shell", "resource": "type *.env*", "effect": "deny" },
    { "action": "read", "resource": "*.env*", "effect": "deny" },
    { "action": "edit", "resource": "*.env*", "effect": "deny" }
  ]
}
